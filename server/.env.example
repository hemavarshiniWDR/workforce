PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_at_least_48_random_bytes_hex
# One-time admin bootstrap key. Remove after creating the first admin.
BOOTSTRAP_KEY=replace_with_a_long_random_bootstrap_key

# Optional custom SQLite path (default: server/data/workforce.sqlite)
# DB_PATH=./data/workforce.sqlite
